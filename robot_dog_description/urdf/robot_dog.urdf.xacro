<?xml version="1.0"?>
<!--
  robot_dog: 12-DOF quadruped designed in Fusion.
    xacro robot_dog.urdf.xacro                     -> RViz / mock hardware
    xacro robot_dog.urdf.xacro sim_mode:=gazebo    -> Gazebo Harmonic + gz_ros2_control
    xacro robot_dog.urdf.xacro sim_mode:=isaac     -> Isaac Sim via joint state topics
          [isaac_command:=effort]                     (torque commands instead of positions)
-->
<robot name="robot_dog" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="sim_mode" default="none"/>
  <xacro:arg name="isaac_command" default="position"/>

  <xacro:include filename="$(find robot_dog_description)/urdf/robot_dog_core.xacro"/>
  <xacro:include filename="$(find robot_dog_description)/urdf/robot_dog.ros2_control.xacro"/>
  <xacro:include filename="$(find robot_dog_description)/urdf/robot_dog.gazebo.xacro"/>

  <xacro:robot_dog_ros2_control mode="$(arg sim_mode)" isaac_command="$(arg isaac_command)"/>
  <xacro:if value="${'$(arg sim_mode)' == 'gazebo'}">
    <xacro:robot_dog_gazebo controllers_file="$(find robot_dog_description)/config/ros2_controllers.yaml"/>
  </xacro:if>
</robot>
